<% content_for :title, plugin_copy("admin.title") %>
<% content_for :subtitle, plugin_copy("admin.subtitle") %>
<% flat_pack_page_nav(
     round: true,
     style: :default,
     back_href: plugin_admin_back_href,
     back_tooltip: plugin_copy("admin.back")
   ) %>

<% if @unconfigured %>
  <%= render FlatPack::EmptyState::Component.new(
    title: plugin_copy("admin.unconfigured.title"),
    description: plugin_copy("admin.unconfigured.description"),
    icon: :squares_2x2
  ) %>
<% elsif @rows.empty? %>
  <%= render FlatPack::EmptyState::Component.new(
    title: plugin_copy("admin.empty.title"),
    description: plugin_copy("admin.empty.description"),
    icon: :squares_2x2
  ) %>
<% else %>
  <%= render FlatPack::Table::Component.new(data: @rows) do |table| %>
    <% table.column(title: plugin_copy("admin.picture")) do |row| %>
      <% if row[:image_url].present? %>
        <%= render FlatPack::Avatar::Component.new(
          src: row[:image_url],
          size: :sm,
          shape: :square,
          alt: row[:name]
        ) %>
      <% end %>
    <% end %>
    <% table.column(title: plugin_copy("admin.display_name")) { |row| row[:name] } %>
    <% table.column(title: plugin_copy("admin.default_name")) { |row| row[:registered_name] } %>
    <% table.column(title: plugin_copy("admin.edit")) do |row| %>
      <%= render FlatPack::Link::Component.new(href: admin_plugin_edit_path(row[:key])) do %>
        <%= plugin_copy("admin.edit") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
