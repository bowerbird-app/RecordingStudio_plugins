<% recording_studio_page_nav(title: plugin_copy("directory.title")) %>

<%= render FlatPack::PageTitle::Component.new(
  title: plugin_copy("directory.title"),
  subtitle: plugin_copy("directory.description")
) %>

<% if @listings.empty? %>
  <%= render FlatPack::EmptyState::Component.new(
    title: plugin_copy("empty.none.title"),
    description: plugin_copy("empty.none.description"),
    icon: :squares_2x2
  ) %>
<% else %>
  <ul class="grid grid-cols-1 md:grid-cols-2 gap-3" role="list">
    <% @listings.each do |listing| %>
      <%= render "listing", listing: listing %>
    <% end %>
  </ul>
<% end %>
