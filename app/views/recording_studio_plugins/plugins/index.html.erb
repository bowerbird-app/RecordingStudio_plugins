<% content_for :title, plugin_copy("directory.title") %>
<% content_for :subtitle, plugin_copy("directory.description_html") %>

<% if @listings.empty? %>
  <%= render FlatPack::EmptyState::Component.new(
    title: plugin_copy("empty.none.title"),
    description: plugin_copy("empty.none.description"),
    icon: :squares_2x2
  ) %>
<% else %>
  <ul class="grid grid-cols-1 md:grid-cols-2 gap-3" role="list">
    <% @listings.each do |listing| %>
      <%= render listing.user? ? "inbound_listing" : "listing", listing: listing %>
    <% end %>
  </ul>
  <% @listings.select(&:user?).each do |listing| %>
    <%= render "inbound_modal", listing: listing %>
  <% end %>
<% end %>
