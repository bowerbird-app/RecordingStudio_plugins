<%= render FlatPack::Modal::Component.new(
  id: plugin_inbound_modal_id(listing),
  title: can_admin_plugins? ? plugin_copy("detail.people_title_html", plugin: listing.name) : listing.name,
  size: :lg
) do |modal| %>
  <% if can_admin_plugins? %>
    <% modal.body do %>
      <%= turbo_frame_tag plugin_inbound_people_frame_id(listing),
            src: plugin_people_path(listing.key),
            loading: :lazy %>
    <% end %>
  <% end %>
<% end %>
