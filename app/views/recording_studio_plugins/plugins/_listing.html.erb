<% trailing = capture do %>
  <span class="inline-flex items-center gap-2">
    <%= plugin_badge(listing) %>
    <%= plugin_action(listing, can_edit: can_edit_plugins?, can_admin: can_admin_plugins?) %>
  </span>
<% end %>

<%= render FlatPack::List::Item.new(icon: listing.icon, trailing: trailing) do %>
  <%= render FlatPack::Link::Component.new(href: plugin_path(listing.key)) do %>
    <%= listing.name %>
  <% end %>
<% end %>
