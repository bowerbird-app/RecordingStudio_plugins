<% recording_studio_page_nav(
  title: @listing.name,
  page_nav_back_url: root_path,
  page_nav_back_label: plugin_copy("directory.title")
) %>

<%= render FlatPack::Shared::IconComponent.new(name: @listing.icon, size: :xl) %>

<%= render FlatPack::PageTitle::Component.new(
  title: @listing.name,
  subtitle: @listing.description
) do |page_title| %>
  <% page_title.slot do %>
    <%= plugin_inbound_status(@listing) || plugin_badge(@listing) %>
    <%= plugin_setup_link(@listing) %>
    <%= plugin_action(@listing, can_edit: can_edit_plugins?, can_admin: can_admin_plugins?) %>
  <% end %>
<% end %>

<% if @listing.message.present? && !@listing.user? %>
  <p><%= @listing.message %></p>
<% end %>

<% if @listing.about.present? %>
  <%= render FlatPack::SectionTitle::Component.new(title: plugin_copy("detail.about")) %>
  <% plugin_paragraphs(@listing.about).each do |paragraph| %>
    <p><%= paragraph %></p>
  <% end %>
<% end %>

<% if @listing.setup_instructions.present? %>
  <%= render FlatPack::SectionTitle::Component.new(title: plugin_copy("detail.setup")) %>
  <% plugin_paragraphs(@listing.setup_instructions).each do |paragraph| %>
    <p><%= paragraph %></p>
  <% end %>
<% end %>

<% if @listing.usage_instructions.present? %>
  <%= render FlatPack::SectionTitle::Component.new(title: plugin_copy("detail.usage")) %>
  <% plugin_paragraphs(@listing.usage_instructions).each do |paragraph| %>
    <p><%= paragraph %></p>
  <% end %>
<% end %>

<% if @listing.user? && can_admin_plugins? %>
  <%= render FlatPack::SectionTitle::Component.new(title: plugin_copy("detail.people")) %>
  <% if @people.blank? %>
    <p><%= plugin_copy("detail.people_empty") %></p>
  <% else %>
    <%= render FlatPack::Table::Component.new(data: plugin_people_rows(@people)) do |table| %>
      <% table.column(title: plugin_copy("detail.person")) { |row| row[:name] } %>
      <% table.column(title: plugin_copy("detail.role")) { |row| row[:role] } %>
      <% table.column(title: plugin_copy("detail.app")) { |row| row[:app] } %>
      <% table.column(title: plugin_copy("detail.connected_since")) { |row| row[:connected_since] } %>
      <% table.column(title: plugin_copy("detail.last_used")) { |row| row[:last_used] } %>
    <% end %>
  <% end %>
<% end %>

<% if @listing.documentation_url %>
  <%= render FlatPack::Link::Component.new(
    href: @listing.documentation_url,
    target: (@listing.documentation_external? ? "_blank" : nil)
  ) do %>
    <%= plugin_copy("detail.documentation") %>
  <% end %>
<% end %>
