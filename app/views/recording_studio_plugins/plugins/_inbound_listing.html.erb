<% trailing = capture do %>
  <%= plugin_setup_button(listing) %>
<% end %>

<%= plugin_directory_row(trailing: trailing) do %>
  <span class="inline-flex items-center gap-2">
    <%= plugin_image(listing) %>
    <span class="min-w-0">
      <%= tag.button(
            listing.name,
            type: "button",
            class: "bg-transparent p-0 font-inherit text-inherit text-start",
            data: { modal_id: plugin_inbound_modal_id(listing) },
            aria: { haspopup: "dialog", controls: plugin_inbound_modal_id(listing) }
          ) %>
      <% if can_admin_plugins? && listing.people_connected_text.present? %>
        <p class="text-sm text-[var(--surface-muted-content-color)]"><%= listing.people_connected_text %></p>
      <% end %>
    </span>
  </span>
<% end %>
