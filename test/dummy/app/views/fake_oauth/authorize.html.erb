<% content_for :title, "Fake provider" %>
<% dummy_page_nav(title: "Fake provider", subtitle: "A dummy stand-in so Connect has somewhere to land.") %>

<%= render FlatPack::Grid::Component.new(cols: 1, gap: :lg) do %>
  <p>This is not Google Drive or Dropbox. Continue to send yourself back to Plugins.</p>
  <%= form_with url: fake_oauth_continue_path, method: :post do %>
    <%= hidden_field_tag :client_id, @client_id %>
    <%= hidden_field_tag :state, @state %>
    <%= hidden_field_tag :redirect_uri, @redirect_uri %>
    <%= hidden_field_tag :code_challenge, @code_challenge %>
    <div class="w-fit">
      <%= render FlatPack::Button::Component.new(
        text: "Continue",
        type: "submit",
        style: :primary
      ) %>
    </div>
  <% end %>
<% end %>
